<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Form View - Add Reservation Status and Unreserve Button -->
    <record id="view_product_template_reservation_form" model="ir.ui.view">
        <field name="name">product.template.reservation.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <!-- Add prominent RESERVED banner at top of form -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning text-center mb-0" role="alert"
                     invisible="reservation_status != 'reserved' or categ_id.name != 'Vehicles'">
                    <strong>
                        <i class="fa fa-lock me-2"/>
                        RESERVED
                    </strong>
                    <span class="ms-2">
                        by <field name="reserved_by_partner_id" readonly="1" class="oe_inline" nolabel="1"/>
                        on <field name="reservation_date" readonly="1" class="oe_inline" nolabel="1" widget="date"/>
                    </span>
                </div>
            </xpath>
            
            <!-- Add Reservation Status fields and button to header area -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <!-- Unreserve Button - only show for reserved vehicles -->
                <button name="action_unreserve_vehicle" 
                        type="object"
                        class="oe_stat_button"
                        icon="fa-unlock"
                        invisible="reservation_status != 'reserved' or categ_id.name != 'Vehicles'"
                        confirm="Are you sure you want to remove the reservation for this vehicle? It will become available for sale again.">
                    <span class="o_stat_text">Unreserve</span>
                </button>
            </xpath>
            
            <!-- Add Reservation fields after basic info -->
            <xpath expr="//group[@name='group_general']" position="after">
                <group string="Reservation Status" name="reservation_info" 
                       invisible="categ_id.name != 'Vehicles'">
                    <group>
                        <field name="reservation_status" widget="badge"
                               decoration-success="reservation_status == 'available'"
                               decoration-warning="reservation_status == 'reserved'"/>
                        <field name="reserved_by_partner_id" 
                               invisible="reservation_status != 'reserved'"
                               readonly="1"/>
                    </group>
                    <group>
                        <field name="reservation_date" 
                               invisible="reservation_status != 'reserved'"
                               readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Action to view reserved vehicles -->
    <record id="action_reserved_vehicles" model="ir.actions.act_window">
        <field name="name">Reserved Vehicles</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('reservation_status', '=', 'reserved'), ('categ_id.name', '=', 'Vehicles')]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No reserved vehicles
            </p>
            <p>
                Vehicles that have been reserved by customers will appear here.
                You can unreserve a vehicle if the customer decides not to proceed.
            </p>
        </field>
    </record>

    <!-- Menu item for Reserved Vehicles under Sales -->
    <menuitem id="menu_reserved_vehicles"
              name="Reserved Vehicles"
              parent="sale.sale_menu_root"
              action="action_reserved_vehicles"
              sequence="14"/>
</odoo>
