<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_custom_add_to_cart" inherit_id="website_sale.cta_wrapper">
        <xpath expr="//a[@id='add_to_cart']" position="replace">
            <t t-if="product.type == 'consu' and product.categ_id.name == 'Vehicles'">
                <!-- Target consumable products in 'Vehicles' category -->
                <!-- product.id here is product.template.id (each template = one unique vehicle) -->
                <a id="reserve_now_btn" 
                   t-attf-href="/appointment/#{request.env.ref('nexus_odoo_car_dealer.appointment_type_vehicle_reservation').sudo().id}?vehicle_template_id=#{product.id}" 
                   class="btn btn-primary btn-lg w-100">
                    <i class="fa fa-calendar me-2"/>Reserve Now
                </a>
            </t>
            <t t-else="">
                <!-- Fallback to original Add to Cart button -->
                <a id="add_to_cart" role="button" href="#" t-attf-class="btn btn-primary js_check_product a-submit flex-grow-1" t-att-data-show-quantity="is_view_active('website_sale.product_quantity')" data-animation-selector=".o_wsale_product_images">
                    <i class="fa fa-shopping-cart me-2"/>
                    Add to cart
                </a>
            </t>
        </xpath>
    </template>
</odoo>