<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Financing Agreement Tree View -->
        <record id="view_financing_agreement_tree" model="ir.ui.view">
            <field name="name">financing.agreement.tree</field>
            <field name="model">financing.agreement</field>
            <field name="arch" type="xml">
                <list string="Financing Agreements" js_class="financing_agreement_list" create="false" open_form_view="True">
                    <field name="partner_id"/>
                    <field name="agreement_date"/>
                    <field name="total_financed_amount" widget="monetary"/>
                    <field name="total_balance" widget="monetary"/>
                    <field name="total_interest_paid" widget="monetary"/>
                    <field name="state" widget="badge" decoration-success="state == 'active'" decoration-info="state == 'draft'" decoration-muted="state == 'closed'"/>
                </list>
            </field>
        </record>

        <!-- Financing Agreement Form View -->
        <record id="view_financing_agreement_form" model="ir.ui.view">
            <field name="name">financing.agreement.form</field>
            <field name="model">financing.agreement</field>
            <field name="arch" type="xml">
                <form string="Financing Agreement" create="false">
                    <header>
                        <button name="action_activate" string="Activate" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_close" string="Close Agreement" type="object" class="btn-secondary" invisible="state != 'active'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_vehicles"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-car">
                                <field name="vehicle_count" widget="statinfo" string="Vehicles"/>
                            </button>
                            <button name="action_view_all_bills"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-file-text-o">
                                <field name="bill_count" widget="statinfo" string="Bills"/>
                            </button>
                            <button name="action_view_journal_entries"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-book">
                                <field name="journal_entry_count" widget="statinfo" string="Journal Entries"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="partner_id"/>
                            <h1>
                                <field name="partner_id" readonly="state != 'draft'" placeholder="Select Lender..."/>
                            </h1>
                        </div>
                        <group>
                            <group string="Agreement Details">
                                <field name="agreement_date" readonly="state != 'draft'"/>
                                <field name="state" invisible="1"/>
                            </group>
                            <group string="Financial Summary">
                                <field name="total_financed_amount" widget="monetary"/>
                                <field name="total_balance" widget="monetary"/>
                                <field name="total_interest_paid" widget="monetary"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Financed Vehicles" name="vehicles">
                                <field name="line_ids" readonly="state == 'closed'">
                                    <list create="false" delete="false" editable="bottom">
                                        <field name="vehicle_id" readonly="1"/>
                                        <field name="financed_amount" sum="Total Principal" readonly="1"/>
                                        <field name="interest_rate" readonly="state == 'active'"/>
                                        <field name="start_date" readonly="1"/>
                                        <field name="current_balance" sum="Total Balance" readonly="1"/>
                                        <field name="accumulated_interest" sum="Total Interest" readonly="1"/>
                                        <field name="state" widget="badge" decoration-success="state == 'active'" decoration-info="state == 'draft'" decoration-muted="state == 'paid_off'"/>
                                        <button name="action_view_vehicle_details" type="object" string="Details" icon="fa-info-circle" class="oe_link"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Transaction History" name="transactions">
                                <field name="transaction_ids" readonly="1">
                                    <list create="false" edit="false" delete="false">
                                        <field name="transaction_date"/>
                                        <field name="vehicle_id"/>
                                        <field name="transaction_type" widget="badge"/>
                                        <field name="amount" widget="monetary"/>
                                        <field name="balance_after" widget="monetary"/>
                                        <field name="journal_entry_id"/>
                                        <field name="notes"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Interest Bills" name="interest_bills">
                                <field name="interest_bill_ids" readonly="1">
                                    <list create="false" edit="false" delete="false">
                                        <field name="bill_date"/>
                                        <field name="vehicle_id"/>
                                        <field name="interest_amount" sum="Total Interest"/>
                                        <field name="bill_id"/>
                                        <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Related Bills" name="related_bills">
                                <field name="related_bill_ids" readonly="1">
                                    <list create="false" edit="false" delete="false">
                                        <field name="name"/>
                                        <field name="partner_id"/>
                                        <field name="invoice_date"/>
                                        <field name="amount_total" string="Total Amount" sum="Total"/>
                                        <field name="amount_residual" string="Amount Due" sum="Total Due"/>
                                        <field name="payment_state" widget="badge" decoration-success="payment_state == 'paid'" decoration-warning="payment_state == 'partial'" decoration-danger="payment_state == 'not_paid'"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Financing Agreement Line Form View (Vehicle Details) -->
        <record id="view_financing_agreement_line_form" model="ir.ui.view">
            <field name="name">financing.agreement.line.form</field>
            <field name="model">financing.agreement.line</field>
            <field name="arch" type="xml">
                <form string="Vehicle Financing Details">
                    <header>
                        <button name="action_topup" string="Top-Up" type="object" class="oe_highlight" invisible="state != 'active'"/>
                        <button name="action_paydown" string="Pay Down" type="object" invisible="state != 'active'"/>
                        <button name="action_mark_paid_off" string="Mark as Paid Off" type="object" class="btn-secondary" invisible="state != 'active' or current_balance > 0"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,active,paid_off"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_vehicle"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-car">
                                <span class="o_stat_text">View Vehicle</span>
                            </button>
                            <button name="action_view_interest_bills"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-file-text">
                                <field name="interest_bill_count" widget="statinfo" string="Interest Bills"/>
                            </button>
                            <button name="action_view_transactions"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-exchange">
                                <field name="transaction_count" widget="statinfo" string="Transactions"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="vehicle_id" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Agreement Info">
                                <field name="agreement_id" readonly="1"/>
                                <field name="partner_id" readonly="1"/>
                                <field name="start_date" readonly="1"/>
                                <field name="end_date"/>
                            </group>
                            <group string="Financing Terms">
                                <field name="financed_amount" readonly="1"/>
                                <field name="interest_rate"/>
                                <field name="current_balance" readonly="1"/>
                                <field name="accumulated_interest" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="Accounting">
                                <field name="expense_account_id"/>
                                <field name="liability_account_id"/>
                                <field name="journal_entry_id" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Transaction History" name="transactions">
                                <field name="transaction_ids" readonly="1">
                                    <list create="false" edit="false" delete="false">
                                        <field name="transaction_date"/>
                                        <field name="transaction_type" widget="badge"/>
                                        <field name="amount" widget="monetary"/>
                                        <field name="balance_after" widget="monetary"/>
                                        <field name="journal_entry_id"/>
                                        <field name="vendor_bill_id"/>
                                        <field name="notes"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Interest Bills" name="interest_bills">
                                <field name="interest_bill_ids" readonly="1">
                                    <list create="false" edit="false" delete="false">
                                        <field name="bill_date"/>
                                        <field name="interest_amount" sum="Total Interest"/>
                                        <field name="bill_id"/>
                                        <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Financing Agreement Line Tree View -->
        <record id="view_financing_agreement_line_tree" model="ir.ui.view">
            <field name="name">financing.agreement.line.tree</field>
            <field name="model">financing.agreement.line</field>
            <field name="arch" type="xml">
                <list string="Financing Lines" open_form_view="True">
                    <field name="agreement_id"/>
                    <field name="vehicle_id"/>
                    <field name="partner_id"/>
                    <field name="financed_amount" widget="monetary" sum="Total Principal"/>
                    <field name="interest_rate"/>
                    <field name="current_balance" widget="monetary" sum="Total Balance"/>
                    <field name="accumulated_interest" widget="monetary" sum="Total Interest"/>
                    <field name="state" widget="badge" decoration-success="state == 'active'" decoration-info="state == 'draft'" decoration-muted="state == 'paid_off'"/>
                </list>
            </field>
        </record>

        <!-- Financing Agreement Line Graph View (Dashboard) -->
        <record id="view_financing_agreement_line_graph" model="ir.ui.view">
            <field name="name">financing.agreement.line.graph</field>
            <field name="model">financing.agreement.line</field>
            <field name="arch" type="xml">
                <graph string="Financing Liability" type="bar" stacked="True">
                    <field name="vehicle_id" type="row"/>
                    <field name="partner_id" type="col"/>
                    <field name="current_balance" type="measure"/>
                    <field name="accumulated_interest" type="measure"/>
                </graph>
            </field>
        </record>
        
        <record id="view_financing_agreement_line_pivot" model="ir.ui.view">
            <field name="name">financing.agreement.line.pivot</field>
            <field name="model">financing.agreement.line</field>
            <field name="arch" type="xml">
                <pivot string="Financing Analysis">
                    <field name="vehicle_id" type="row"/>
                    <field name="partner_id" type="col"/>
                    <field name="financed_amount" type="measure"/>
                    <field name="current_balance" type="measure"/>
                    <field name="accumulated_interest" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Actions -->
        <record id="action_financing_agreement" model="ir.actions.act_window">
            <field name="name">Financing Agreements</field>
            <field name="res_model">financing.agreement</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_financing_agreement_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_financing_agreement_form')})]"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new financing agreement
                </p>
                <p>
                    Click "New" to create a financing agreement for one or more vehicles.
                </p>
            </field>
        </record>

        <!-- Action for viewing financing lines (used from product page) -->
        <record id="action_financing_agreement_line" model="ir.actions.act_window">
            <field name="name">Financing Lines</field>
            <field name="res_model">financing.agreement.line</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_financing_agreement_line_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_financing_agreement_line_form')})]"/>
        </record>

        <record id="action_financing_dashboard" model="ir.actions.act_window">
            <field name="name">Financing Dashboard</field>
            <field name="res_model">financing.agreement.line</field>
            <field name="view_mode">graph,pivot</field>
            <field name="domain">[('state', '=', 'active')]</field>
        </record>

        <!-- Menus -->
        <menuitem id="menu_financing_agreement"
                  name="Agreements"
                  parent="menu_financing_root"
                  action="action_financing_agreement"
                  sequence="5"/>

        <menuitem id="menu_financing_dashboard"
                  name="Dashboard"
                  parent="menu_financing_root"
                  action="action_financing_dashboard"
                  sequence="1"/>
    </data>
</odoo>
