<odoo>
    <data>
        <!-- Vehicle Financing List View -->
        <record id="view_vehicle_financing_tree" model="ir.ui.view">
            <field name="name">vehicle.financing.list</field>
            <field name="model">vehicle.financing</field>
            <field name="arch" type="xml">
                <list string="Financing History" create="false" edit="false">
                    <field name="bill_date"/>
                    <field name="interest_amount"/>
                    <field name="bill_id"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- Vehicle Financing Form View -->
        <record id="view_vehicle_financing_form" model="ir.ui.view">
            <field name="name">vehicle.financing.form</field>
            <field name="model">vehicle.financing</field>
            <field name="arch" type="xml">
                <form string="Financing Bill" create="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="product_id" readonly="True"/>
                                <field name="bill_date" readonly="True"/>
                            </group>
                            <group>
                                <field name="interest_amount" readonly="True"/>
                                <field name="bill_id" readonly="True"/>
                                <field name="state" readonly="True"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Product Template Form View - Add Financing Tab -->
        <record id="view_product_template_financing_form" model="ir.ui.view">
            <field name="name">product.template.financing.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <!-- Add Financing reference after Sales tab -->
                <xpath expr="//notebook" position="inside">
                    <page string="Financing" name="financing" invisible="financing_agreement_count == 0">
                        <group>
                            <field name="financing_agreement_count" invisible="1"/>
                        </group>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_financing_agreements"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-file-text-o">
                                <field name="financing_agreement_count" widget="statinfo" string="Agreements"/>
                            </button>
                        </div>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Purchase Order Form View - Add Financing Button -->
        <record id="view_purchase_order_financing_form" model="ir.ui.view">
            <field name="name">purchase.order.financing.form</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button name="action_view_financed_vehicles"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-car"
                            invisible="financed_vehicle_count == 0">
                        <field name="financed_vehicle_count" widget="statinfo" string="Financed"/>
                    </button>
                </div>
            </field>
        </record>

        <!-- Standalone Financing Actions & Menus -->
        <record id="action_financing_vehicles" model="ir.actions.act_window">
            <field name="name">Financed Vehicles</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">list,form,kanban</field>
            <field name="domain">[('financing_type', '!=', 'none')]</field>
            <field name="context">{'default_financing_type': 'internal'}</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                No financed vehicles found
              </p><p>
                Track your floor plan financing and interest payments here.
              </p>
            </field>
        </record>

        <record id="action_financing_bills" model="ir.actions.act_window">
            <field name="name">Interest Bills</field>
            <field name="res_model">vehicle.financing</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                No interest bills generated yet
              </p>
            </field>
        </record>

        <menuitem id="menu_financing_root"
                  name="Financing"
                  sequence="40"/>

        <menuitem id="menu_financing_vehicles"
                  name="Vehicles"
                  parent="menu_financing_root"
                  action="action_financing_vehicles"
                  sequence="10"/>

        <menuitem id="menu_financing_bills"
                  name="Interest Bills"
                  parent="menu_financing_root"
                  action="action_financing_bills"
                  sequence="20"/>
    </data>
</odoo>
