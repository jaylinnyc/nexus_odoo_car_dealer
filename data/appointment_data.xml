<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="reservation_product_xmlid" model="product.template">
        <field name="name">View Reserved Vehicle</field>
        <field name="type">service</field>
        <field name="list_price">100.0</field>
        <field name="sale_ok">True</field>        <!-- Enable for sales/eCommerce -->
        <field name="purchase_ok">False</field>        <!-- Optional: Disable purchases if not needed -->
        <field name="categ_id" search="[('name', '=', 'Services')]" model="product.category"/>
        <field name="taxes_id" eval="[(5, 0, 0)]"/>  <!-- Remove all sales taxes -->
    </record>

    <!-- Generic Showroom Appointment Resource for Vehicle Reservations -->
    <record id="appointment_resource_showroom" model="appointment.resource">
        <field name="name">Showroom</field>
        <field name="capacity">10</field>  <!-- Can handle multiple appointments -->
    </record>

    <record id="appointment_type_vehicle_reservation" model="appointment.type">
        <field name="name">View Reserved Vehicle</field>
        <field name="appointment_duration">1.0</field>
        <field name="schedule_based_on">resources</field>
        <field name="resource_ids" eval="[(6, 0, [ref('appointment_resource_showroom')])]"/>
        <field name="product_id" ref="nexus_odoo_car_dealer.reservation_product_xmlid"/>
    </record>
</odoo>