<odoo>
    <data>
        <!-- Cron job to generate monthly interest bills -->
        <record id="ir_cron_generate_interest_bills" model="ir.cron">
            <field name="name">Generate Monthly Interest Bills for Vehicle Financing</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_monthly_interest_bills()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
