<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="account_floor_plan_receivable" model="account.account">
            <field name="code">110099</field>
            <field name="name">Floor Plan Receivable - Dealers</field>
            <field name="account_type">asset_receivable</field>
            <field name="reconcile">True</field>
        </record>

        <record id="account_interest_receivable" model="account.account">
            <field name="code">111099</field>
            <field name="name">Interest Receivable - Dealers</field>
            <field name="account_type">asset_receivable</field>
            <field name="reconcile">True</field>
        </record>

        <record id="account_floor_plan_payable" model="account.account">
            <field name="code">220000</field>
            <field name="name">Floor Plan Payable</field>
            <field name="account_type">liability_payable</field>
            <field name="reconcile">True</field>
        </record>

        <record id="account_interest_payable" model="account.account">
            <field name="code">221000</field>
            <field name="name">Interest Payable</field>
            <field name="account_type">liability_payable</field>
            <field name="reconcile">True</field>
        </record>

        <record id="account_interest_expense" model="account.account">
            <field name="code">670000</field>
            <field name="name">Interest Expense - Vehicle Financing</field>
            <field name="account_type">expense</field>
            <field name="reconcile">False</field>
        </record>

        <record id="seq_financing_agreement" model="ir.sequence">
            <field name="name">Financing Agreement</field>
            <field name="code">financing.agreement</field>
            <field name="prefix">FA/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <function model="ir.default" name="set">
            <value>product.template</value>
            <value>financing_expense_account_id</value>
            <value eval="ref('account_interest_payable')"/>
        </function>

        <function model="ir.default" name="set">
            <value>product.template</value>
            <value>financing_liability_account_id</value>
            <value eval="ref('account_floor_plan_payable')"/>
        </function>
    </data>
</odoo>